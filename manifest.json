{
  "manifest_version": 3,
  "name": "AIO 구매 도우미",
  "version": "0.4.0",
  "description": "주문서·결제창 자동 클릭, 네이버페이·L.PAY 간편결제 비밀번호 입력, 롯데온 바로 구매하기, 디스코드 알림 인-익스텐션 모니터링",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "debugger", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["keypad.js", "content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "AIO 구매 도우미" },
  "options_page": "options.html"
}
